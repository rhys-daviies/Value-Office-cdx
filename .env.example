# Copy to .env.local for local development. Names and descriptions only — never commit real values.
# Validation lives in src/server/env.ts; production refuses unsafe or incomplete configuration.

# --- Database -------------------------------------------------------------------------------
# Application connection. Production: the least-privilege application role (not the owner),
# ideally the provider's pooled connection string. See docs/deployment.md.
# Homebrew PostgreSQL 16 on this machine listens on 5433 (5432 is used by a separate EDB PostgreSQL 18 install).
DATABASE_URL=postgres://localhost:5433/value_office_dev
# Migrations only (owner role). Falls back to DATABASE_URL locally. Never set in the Vercel runtime.
# MIGRATION_DATABASE_URL=
# With migrations: application role to (re)grant after migrating, e.g. vo_app.
# VO_APP_DB_ROLE=
# Connections per server instance (default 10; use ~3–5 on serverless with a pooler).
# VO_DB_POOL_MAX=

# Used only by the test suite. Must point at a database whose name ends in _test: it is reset on every run.
TEST_DATABASE_URL=postgres://localhost:5433/value_office_test
# Used only by Playwright. Must end in _e2e: it is created if missing and reset on every e2e run.
E2E_DATABASE_URL=postgres://localhost:5433/value_office_e2e

# --- Authentication ---------------------------------------------------------------------------
# password (default; the only mode allowed in production) or dev (local convenience only).
# Local development: dev mode is implied when VO_DEV_USER_EMAIL is set and NODE_ENV is not production.
VO_DEV_USER_EMAIL=consultant@cardaxia.ai
VO_DEV_USER_NAME=Dev Consultant
# VO_AUTH_MODE=password
# Required for password mode: ≥ 32 random characters (e.g. `openssl rand -hex 32`). Rotating it signs everyone out.
# VO_SESSION_SECRET=
# Session lifetime in hours (default 12, max 168).
# VO_SESSION_TTL_HOURS=
# Production: the public origin, e.g. https://value-office.example.com (origin checks and redirects).
# VO_APP_ORIGIN=

# --- Issued report storage ----------------------------------------------------------------------
# local (default; development/test) or s3 (required in production). Objects are private.
# VO_REPORT_STORAGE=local
# Local store directory (default ./storage/reports).
# VO_REPORT_STORAGE_DIR=storage/reports
# S3-compatible private bucket (AWS S3, Cloudflare R2, …). All four of bucket, region, key id and secret are required.
# VO_S3_BUCKET=
# VO_S3_REGION=              # e.g. eu-west-2; "auto" for Cloudflare R2
# VO_S3_ENDPOINT=            # only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
# VO_S3_ACCESS_KEY_ID=
# VO_S3_SECRET_ACCESS_KEY=
# VO_S3_FORCE_PATH_STYLE=    # true for providers that need path-style URLs
# VO_S3_PREFIX=              # optional key prefix, e.g. prod/

# --- PDF rendering ---------------------------------------------------------------------------------
# playwright (default; local Chromium from `npx playwright install chromium`) or serverless (@sparticuz/chromium,
# required on Vercel). Must be set explicitly in production.
# VO_PDF_RUNTIME=playwright
# VO_CHROMIUM_EXECUTABLE=
