# Copy to .env.local for local development.

# Homebrew PostgreSQL 16 on this machine listens on 5433 (5432 is used by a separate EDB PostgreSQL 18 install).
DATABASE_URL=postgres://localhost:5433/value_office_dev

# Used only by the test suite. Must point at a database whose name ends in _test: it is reset on every run.
TEST_DATABASE_URL=postgres://localhost:5433/value_office_test

# Used only by Playwright. Must end in _e2e: it is created if missing and reset on every e2e run.
E2E_DATABASE_URL=postgres://localhost:5433/value_office_e2e

# Development authentication (see src/server/auth/actor.ts). Ignored in production builds.
VO_DEV_USER_EMAIL=consultant@cardaxia.ai
VO_DEV_USER_NAME=Dev Consultant

# Issued report PDFs (local, content-addressed artefact store). Default: ./storage/reports
# VO_REPORT_STORAGE_DIR=storage/reports
# PDF generation uses Playwright's Chromium (`npx playwright install chromium`); override if needed:
# VO_CHROMIUM_EXECUTABLE=/path/to/chromium
