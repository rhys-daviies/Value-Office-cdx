{
  "name": "value-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:seed:horizon": "tsx --conditions=react-server scripts/seed-horizon.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:verify": "drizzle-kit check && drizzle-kit generate && git diff --exit-code -- drizzle && test -z \"$(git status --porcelain -- drizzle)\"",
    "db:seed:compact": "tsx --conditions=react-server scripts/seed-compact.ts",
    "reports:smoke": "tsx --conditions=react-server scripts/report-smoke.ts",
    "user:create": "tsx --conditions=react-server scripts/user.ts create",
    "user:set-password": "tsx --conditions=react-server scripts/user.ts set-password",
    "user:disable": "tsx --conditions=react-server scripts/user.ts disable",
    "db:check-role": "tsx scripts/db-check-role.ts",
    "fixture:horizon:align": "tsx --conditions=react-server scripts/fixture-horizon-align.ts",
    "verify:bundle": "node scripts/verify-function-bundle.mjs",
    "smoke:deploy": "playwright test --config playwright.deploy.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@sparticuz/chromium": "153.0.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
